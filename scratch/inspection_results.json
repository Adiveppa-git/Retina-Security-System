  "app_jsx_content": "import { Routes, Route } from \"react-router-dom\";\n\nimport Navbar from \"./components/Navbar\";\n\nimport Home from \"./pages/Home\";\nimport Register from \"./pages/Register\";\nimport Verify from \"./pages/Verify\";\nimport Users from \"./pages/Users\";\nimport Logs from \"./pages/Logs\";\nimport Dashboard from \"./pages/Dashboard\";\nimport TimeStarter from \"./pages/TimeStarter\";\nimport Inside from \"./pages/Inside\";\n\nimport \"./styles/App.css\";\n\nfunction App() {\n  return (\n    <div className=\"app-layout\">\n      <Navbar />\n      <main className=\"app-main-content\">\n        <Routes>\n          <Route path=\"/\" element={<Home />} />\n          <Route path=\"/register\" element={<Register />} />\n          <Route path=\"/verify\" element={<Verify />} />\n          <Route path=\"/time-starter\" element={<TimeStarter />} />\n          <Route path=\"/inside\" element={<Inside />} />\n          <Route path=\"/users\" element={<Users />} />\n          <Route path=\"/logs\" element={<Logs />} />\n          <Route path=\"/dashboard\" element={<Dashboard />} />\n        </Routes>\n      </main>\n    </div>\n  );\n}\n\nexport default App;",
  "navbar_content": "import { useState } from \"react\";\nimport { NavLink } from \"react-router-dom\";\nimport { FaShieldAlt, FaBars, FaTimes } from \"react-icons/fa\";\nimport \"../styles/Navbar.css\";\n\nfunction Navbar() {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const toggleMenu = () => setMobileMenuOpen(!mobileMenuOpen);\n  const closeMenu = () => setMobileMenuOpen(false);\n\n  return (\n    <nav className=\"navbar\">\n      <div className=\"navbar-container\">\n        <NavLink to=\"/\" className=\"navbar-brand\" onClick={closeMenu}>\n          <FaShieldAlt className=\"brand-icon\" />\n          <span>Iris Security System</span>\n        </NavLink>\n\n        <button className=\"mobile-toggle\" onClick={toggleMenu} aria-label=\"Toggle Navigation Menu\">\n          {mobileMenuOpen ? <FaTimes /> : <FaBars />}\n        </button>\n\n        <ul className={`nav-links ${mobileMenuOpen ? \"active\" : \"\"}`}>\n          <li>\n            <NavLink\n              to=\"/\"\n              end\n              onClick={closeMenu}\n              className={({ isActive }) =>\n                isActive ? \"nav-link active-link\" : \"nav-link\"\n              }\n            >\n              Home\n            </NavLink>\n          </li>\n          <li>\n            <NavLink\n              to=\"/register\"\n              onClick={closeMenu}\n              className={({ isActive }) =>\n                isActive ? \"nav-link active-link\" : \"nav-link\"\n              }\n            >\n              Register User\n            </NavLink>\n          </li>\n          <li>\n            <NavLink\n              to=\"/verify\"\n              onClick={closeMenu}\n              className={({ isActive }) =>\n                isActive ? \"nav-link active-link\" : \"nav-link\"\n              }\n            >\n              Verify Iris\n            </NavLink>\n          </li>\n          <li>\n            <NavLink\n              to=\"/users\"\n              onClick={closeMenu}\n              className={({ isActive }) =>\n                isActive ? \"nav-link active-link\" : \"nav-link\"\n              }\n            >\n              Users\n            </NavLink>\n          </li>\n          <li>\n            <NavLink\n              to=\"/inside\"\n              onClick={closeMenu}\n              className={({ isActive }) =>\n                isActive ? \"nav-link active-link\" : \"nav-link\"\n              }\n            >\n              \ud83d\udfe2 Inside\n            </NavLink>\n          </li>\n          <li>\n            <NavLink\n              to=\"/logs\"\n              onClick={closeMenu}\n              className={({ isActive }) =>\n                isActive ? \"nav-link active-link\" : \"nav-link\"\n              }\n            >\n              Access Logs\n            </NavLink>\n          </li>\n          <li>\n            <NavLink\n              to=\"/dashboard\"\n              onClick={closeMenu}\n              className={({ isActive }) =>\n                isActive ? \"nav-link active-link\" : \"nav-link\"\n              }\n            >\n              Dashboard\n            </NavLink>\n          </li>\n        </ul>\n      </div>\n    </nav>\n  );\n}\n\nexport default Navbar;",
